# Variable names and descriptions only. Never commit real values. Copy to .env locally.

# Phase 0 needs NO keys for options B and C (OpenFreeMap and Mapterhorn are keyless).

# Option A only (Mapbox via @rnmapbox/maps). Public access token (pk.*), needed by the SDK at runtime.
MAPBOX_PUBLIC_TOKEN=

# Optional: override DEM / vector sources (e.g. a self-hosted PMTiles extract for offline tests).
DEM_TILE_URL=
DEM_TILEJSON_URL=
VECTOR_STYLE_URL=

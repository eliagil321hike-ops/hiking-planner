{
  "appId": "io.github.eliagil321hikeops.topo3d",
  "appName": "Topo3D",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "style": "LIGHT",
      "hidden": false
    }
  },
  "backgroundColor": "#F3F6F8"
}
